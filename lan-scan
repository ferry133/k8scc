#!/usr/bin/env bash
#
# lan-scan: the LAN scan im-policy asks im for (k8scc#105), and nothing else.
#
#   lan-scan <IPv4 network/prefix> [<network/prefix> ...]
#
# For each network: host discovery with nmap (`nmap -sn -n`, no port scan, no
# reverse DNS), then `arp-scan` of the same network. The permission profile
# allows this command and not nmap or arp-scan themselves, because a rule
# `Bash(nmap -sn *)` also matches `nmap -sn --script=…` (NSE runs Lua),
# `-oN <path>` (writes any file) and `-iL <file>` (reads one), and arp-scan has
# `--pcapsavefile` (found by the commit security review, 2026-11-22). So the
# arguments here are networks only: dotted IPv4, each octet 0-255, prefix
# 16-32 (a /8 is 16 million addresses), at most 8 of them. Anything else is
# refused before either tool runs, and nothing from the arguments is passed
# that a tool could read as an option.
#
# Exit: 0 when both tools succeeded for every network, 1 when one of them
# failed (its output is still printed), 2 for a refused argument.

set -uo pipefail

usage() { echo "usage: lan-scan <IPv4 network/prefix 16-32> [...] (at most 8)" >&2; exit 2; }

[ $# -ge 1 ] && [ $# -le 8 ] || usage
for net in "$@"; do
    if ! [[ "$net" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,2})$ ]]; then
        echo "lan-scan: refused $(printf %q "$net"): not an IPv4 network/prefix" >&2; exit 2
    fi
    for i in 1 2 3 4; do
        [ "$((10#${BASH_REMATCH[$i]}))" -le 255 ] || { echo "lan-scan: refused $(printf %q "$net"): octet over 255" >&2; exit 2; }
    done
    p=$((10#${BASH_REMATCH[5]}))
    [ "$p" -ge 16 ] && [ "$p" -le 32 ] || { echo "lan-scan: refused $(printf %q "$net"): prefix must be 16-32" >&2; exit 2; }
done

rc=0
for net in "$@"; do
    echo "## nmap -sn -n $net"
    nmap -sn -n "$net" || rc=1
    echo "## arp-scan $net"
    arp-scan "$net" || rc=1
done
exit "$rc"
