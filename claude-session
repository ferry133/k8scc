#!/bin/bash
# Runs inside the ttyd terminal session.
# 1. Ensure per-user HOME directories exist
# 2. Inject MCP memory server into settings.json if DATABASE_URL is set
# 3. exec bash
# CLAUDE_USER_ID is set by the pod environment (oauth2-proxy handles auth externally)

# Prefer email injected by oauth2-proxy via X-Forwarded-Email: ttyd is run
# with --auth-header X-Forwarded-Email, which surfaces the value as TTYD_USER.
# (ttyd does NOT do CGI-style HTTP_* header-to-env mapping.)
if [ -n "${TTYD_USER}" ]; then
    export CLAUDE_USER_ID="${TTYD_USER}"
else
    export CLAUDE_USER_ID="${CLAUDE_USER_ID:-claude_code}"
fi

# Initialize settings.json on first login
mkdir -p /home/claude/.claude
if [ ! -f /home/claude/.claude/settings.json ]; then
    echo '{"env":{"DISABLE_AUTOUPDATER":"1"}}' > /home/claude/.claude/settings.json
fi

# Inject MCP memory server into settings.json if DATABASE_URL is configured
if [ -n "${DATABASE_URL}" ]; then
    python3 - <<'PYEOF'
import json, os
p = "/home/claude/.claude/settings.json"
with open(p) as f:
    s = json.load(f)
s.setdefault("mcpServers", {})["memory"] = {
    "command": "python3",
    "args": ["/usr/local/bin/memory_mcp_server.py"],
    "env": {
        "DATABASE_URL": os.environ["DATABASE_URL"],
        "CLAUDE_USER_ID": os.environ.get("CLAUDE_USER_ID", "claude_code"),
    },
}
with open(p, "w") as f:
    json.dump(s, f, indent=2)
PYEOF
fi

# Register the talos-mcp sidecar (if present) as a *remote* MCP server --
# unlike memory (a local stdio subprocess of this shell), talos-mcp runs in
# its own container so its os:reader Talos credential never touches this
# shell's filesystem/env. TALOS_MCP_URL is set by the HelmRelease only when
# the sidecar container exists.
if [ -n "${TALOS_MCP_URL}" ]; then
    python3 - <<'PYEOF'
import json, os
p = "/home/claude/.claude/settings.json"
with open(p) as f:
    s = json.load(f)
s.setdefault("mcpServers", {})["talos"] = {
    "type": "sse",
    "url": os.environ["TALOS_MCP_URL"],
}
with open(p, "w") as f:
    json.dump(s, f, indent=2)
PYEOF
fi

echo ""
echo "✓ 歡迎，${CLAUDE_USER_ID}"
echo ""

exec claude
