#!/bin/bash
# Runs inside the ttyd terminal session.
# 1. Ensure per-user HOME directories exist
# 2. Register MCP servers (memory if DATABASE_URL, talos if TALOS_MCP_URL) and,
#    for talos, merge the permission profile into settings.json
# 3. Configure im's apps repo (if IM_APPS_REPO and its write key are both here):
#    ssh alias + git identity, and git/sops into the permission profile
# 4. Announce ~/workspace/inbox/ if it holds anything unread
# 5. exec tmux → claude
# CLAUDE_USER_ID is set by the pod environment (oauth2-proxy handles auth externally)

# HOME is /home/claude in the image (Dockerfile pins it); the fallback only
# matters when the controls in test/ run this script with HOME redirected.
CLAUDE_HOME="${HOME:-/home/claude}"

# Prefer email injected by oauth2-proxy via X-Forwarded-Email: ttyd is run
# with --auth-header X-Forwarded-Email, which surfaces the value as TTYD_USER.
# (ttyd does NOT do CGI-style HTTP_* header-to-env mapping.)
if [ -n "${TTYD_USER}" ]; then
    export CLAUDE_USER_ID="${TTYD_USER}"
else
    export CLAUDE_USER_ID="${CLAUDE_USER_ID:-claude_code}"
fi

# --- helpers -----------------------------------------------------------------
# test/claude-session-controls.sh runs this whole script against fake `claude`
# and `tmux` binaries, so these are exercised as shipped, not as copied.

# merge_permissions FILE ALLOW... [-- UNASK...]: append each ALLOW entry to
# permissions.allow, and drop each UNASK entry from permissions.ask.
#
# The Talos profile: all five tools auto-allowed -- reboot_node included
# since the 2026-10-15 ruling (im is the company's tool and only company staff reach this ttyd; the reboot's gates are
# the sidecar's own, not a prompt). The entry this profile used to put under
# `ask` is moved out: pods that ran the previous image carry it on the PVC, and
# one name under both lists is a question the permission layer answers however
# it likes. Appends without duplicates, never removes or reorders anything
# else, and writes nothing when the result is byte-identical, so a second run
# is a no-op. python3 rather than jq: python3 is in the base image for the MCP
# servers; jq only in factory. A file it cannot parse is left exactly as it was
# and the failure is said.
#
# The apps-repo profile (`Bash(git *)`, `Bash(sops *)`) goes through the same
# merge, independently of the Talos one: either may be present without the
# other.
merge_permissions() {
    python3 - "$@" <<'PY'
import json, pathlib, sys

args = sys.argv[2:]
ALLOW = args[:args.index("--")] if "--" in args else args
LEAVE_ASK = args[args.index("--") + 1:] if "--" in args else []

path = pathlib.Path(sys.argv[1])
raw = path.read_text() if path.exists() else ""
try:
    data = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError as exc:
    sys.exit(f"{path}: not valid JSON ({exc}); left untouched")
if not isinstance(data, dict):
    sys.exit(f"{path}: top level is not an object; left untouched")
perms = data.setdefault("permissions", {})
if not isinstance(perms, dict):
    sys.exit(f"{path}: permissions is not an object; left untouched")
allow = perms.setdefault("allow", [])
if not isinstance(allow, list):
    sys.exit(f"{path}: permissions.allow is not a list; left untouched")
for entry in ALLOW:
    if entry not in allow:
        allow.append(entry)
ask = perms.get("ask")
if ask is not None:
    if not isinstance(ask, list):
        sys.exit(f"{path}: permissions.ask is not a list; left untouched")
    perms["ask"] = [entry for entry in ask if entry not in LEAVE_ASK]
new = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
if new != raw:
    path.write_text(new)
PY
}

TALOS_ALLOW=(mcp__talos__get_node_status mcp__talos__get_etcd_members
             mcp__talos__get_link_status mcp__talos__get_service_logs
             mcp__talos__reboot_node)
TALOS_UNASK=(mcp__talos__reboot_node)   # where this profile put it before 2026-10-15
APPS_ALLOW=('Bash(git *)' 'Bash(sops *)')

# configure_apps_repo HOME: im's write path to its own apps repo (openspec
# im-apps-repo). Both inputs must be here -- IM_APPS_REPO (owner/repo) and the
# write key jg-base mounts at ~/.ssh/im-apps.key -- and the key must pass ssh's
# OWN permission rule, or nothing is written and one line names what is missing.
#
# ssh's rule, not a fixed mode: group/other bits are refused only when the key
# is owned by the caller. Today im runs as root and Secret volumes are always
# root-owned, so 0400 and 0600 both pass; a non-root im would get the key via
# fsGroup as root:<fsGroup> 0440, which ssh accepts and so must this.
#
# `core.sshCommand = ssh -F <home>/.ssh/config` is the load-bearing line.
# OpenSSH finds its user config through the passwd entry's home, not $HOME,
# and this pod runs as uid 0 with HOME pinned to /home/claude: without -F the
# alias below is never read (it would be /root/.ssh/config), while git does
# read ~/.gitconfig through $HOME -- an identity with no key. Measured on
# OpenSSH 10.2: a HOME-redirected `ssh -G <alias>` ignored the file, `-F`
# resolved it.
#
# Idempotent: each file is written only when its content would change. The
# ssh config is this script's own file (marked on its first line); one
# without the mark is not overwritten.
configure_apps_repo() {
    local home="$1" key="$1/.ssh/im-apps.key" cfg="$1/.ssh/config" reason=""
    local mark="# written by claude-session (im-apps-repo); edit claude-session, not this file"
    if [ -z "${IM_APPS_REPO}" ]; then
        return 1
    elif ! [[ "${IM_APPS_REPO}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
        reason="IM_APPS_REPO='${IM_APPS_REPO}' 不是 owner/repo"
    elif [ ! -f "$key" ]; then
        reason="寫入金鑰不在 ${key/#"$HOME"/\~}"
    elif [ ! -r "$key" ]; then
        reason="寫入金鑰 ${key/#"$HOME"/\~} 讀不到"
    elif ! reason=$(python3 - "$key" <<'PY'
import os, stat, sys
st = os.stat(sys.argv[1])
if st.st_uid == os.getuid() and st.st_mode & 0o077:
    print(f"寫入金鑰 mode {stat.S_IMODE(st.st_mode):04o}：自己擁有的私鑰不得有 group/other 位元，ssh 會拒用")
    sys.exit(1)
PY
    ); then
        :
    fi
    if [ -n "$reason" ]; then
        echo "⚠ apps repo 沒有設定：${reason}" >&2
        return 1
    fi

    local want
    want=$(printf '%s\n' "$mark" \
        'Host github.com-im-apps' \
        '  HostName github.com' \
        '  User git' \
        "  IdentityFile $key" \
        '  IdentitiesOnly yes' \
        '  UserKnownHostsFile /etc/ssh/github-known-hosts' \
        '  HostKeyAlias github.com' \
        '  StrictHostKeyChecking yes')
    if [ -e "$cfg" ] && [ "$(head -n 1 "$cfg")" != "$mark" ]; then
        echo "⚠ apps repo 沒有設定：${cfg/#"$HOME"/\~} 不是 claude-session 寫的，沒有覆蓋" >&2
        return 1
    fi
    if [ "$(cat "$cfg" 2>/dev/null)" != "$want" ]; then
        mkdir -p "$home/.ssh" && printf '%s\n' "$want" > "$cfg" || return 1
    fi

    local k v
    while IFS='=' read -r k v; do
        if [ "$(git config --global --get "$k")" != "$v" ]; then
            git config --global "$k" "$v" || return 1
        fi
    done <<EOF
user.name=im
user.email=im@${IM_APPS_REPO#*/}
core.sshCommand=ssh -F $cfg
EOF
}

# Print one line when the inbox directory holds a file not yet marked read
# (anything not ending in `.read`). Counts files; never opens them. Prints
# nothing when the directory is absent, empty, or fully read.
inbox_notice() {
    local dir="$1" n
    [ -d "$dir" ] || return 0
    n=$(find "$dir" -mindepth 1 -maxdepth 1 -type f ! -name '*.read' | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] || return 0
    printf '📥 inbox: %s file(s) — read %s/ before anything else\n' "$n" "${dir/#"$HOME"/\~}"
}

# --- settings.json -------------------------------------------------------------
mkdir -p "${CLAUDE_HOME}/.claude"
if [ ! -f "${CLAUDE_HOME}/.claude/settings.json" ]; then
    echo '{"env":{"DISABLE_AUTOUPDATER":"1"}}' > "${CLAUDE_HOME}/.claude/settings.json"
fi

# Register MCP servers via `claude mcp add --scope local` (writes to
# ~/.claude/.claude.json, keyed to this project dir) -- NOT settings.json's
# `mcpServers` key, which Claude Code CLI 2.1.220 no longer reads at all
# (confirmed live 2026-07-30: entries sat in settings.json inertly, `claude
# mcp list` never showed them). `--scope local` is per-user/per-project and
# needs no interactive trust-dialog approval, unlike `--scope project`
# (.mcp.json, shared, would prompt on every new session). `claude mcp get`
# exits 0 if already registered -- idempotent across repeat ttyd connections
# to the same long-lived pod.

# Inject MCP memory server if DATABASE_URL is configured.
# The server name must come BEFORE the -e flags: -e is variadic
# (`-e <env...>`), so it eats every following bare word and a trailing
# name is rejected as a malformed KEY=value (confirmed live 2026-09-06,
# CLI 2.1.228). Add errors go to mcp-add.log and flag the terminal --
# a swallowed failure here reads identically to success.
if [ -n "${DATABASE_URL}" ]; then
    if ! claude mcp get memory >/dev/null 2>&1; then
        if ! claude mcp add --scope local memory \
            -e DATABASE_URL="${DATABASE_URL}" \
            -e CLAUDE_USER_ID="${CLAUDE_USER_ID}" \
            -- python3 /usr/local/bin/memory_mcp_server.py \
            >>"${CLAUDE_HOME}/.claude/mcp-add.log" 2>&1; then
            echo "⚠ claude mcp add memory 失敗——見 ~/.claude/mcp-add.log" >&2
        fi
    fi
fi

# Register the talos-mcp sidecar (if present) as a *remote* MCP server --
# unlike memory (a local stdio subprocess of this shell), talos-mcp runs in
# its own container so its Talos credentials never touch this shell's
# filesystem/env. TALOS_MCP_URL is set by the HelmRelease only when the
# sidecar container exists -- the same gate decides whether the permission
# profile below is written: no sidecar, `permissions` is not touched.
if [ -n "${TALOS_MCP_URL}" ]; then
    if ! claude mcp get talos >/dev/null 2>&1; then
        if ! claude mcp add --transport sse --scope local talos "${TALOS_MCP_URL}" \
            >>"${CLAUDE_HOME}/.claude/mcp-add.log" 2>&1; then
            echo "⚠ claude mcp add talos 失敗——見 ~/.claude/mcp-add.log" >&2
        fi
    fi
    if ! merge_permissions "${CLAUDE_HOME}/.claude/settings.json" \
            "${TALOS_ALLOW[@]}" -- "${TALOS_UNASK[@]}"; then
        echo "⚠ settings.json 的 talos permission 設定沒有寫入（見上一行）——mcp__talos__* 每次都會問" >&2
    fi
fi

# im's apps repo: the remote is git@github.com-im-apps:${IM_APPS_REPO}.git.
# No IM_APPS_REPO -> silent and nothing written, the common case. git/sops
# join the permission profile only when the write path really exists.
if configure_apps_repo "${CLAUDE_HOME}"; then
    if ! merge_permissions "${CLAUDE_HOME}/.claude/settings.json" "${APPS_ALLOW[@]}"; then
        echo "⚠ settings.json 的 git/sops permission 設定沒有寫入（見上一行）" >&2
    fi
fi

echo ""
echo "✓ 歡迎，${CLAUDE_USER_ID}"
echo ""

# Company colleagues who are not at this ttyd drop hand-over notes for im into
# ~/workspace/inbox/ (on the workspace PVC). Say so before the agent starts. tmux clears the screen the
# moment it attaches, so the line gets a short, Enter-skippable pause --
# otherwise it is on screen for one frame, which is the same as not printed.
if notice=$(inbox_notice "${CLAUDE_HOME}/workspace/inbox") && [ -n "${notice}" ]; then
    echo "${notice}"
    read -r -t 8 -p "（按 Enter 繼續；8 秒後自動繼續）" _ 2>/dev/null || true
    echo ""
fi

# -A: attach to the "claude" tmux session if it already exists (a
# reconnecting ttyd WebSocket after an idle disconnect) instead of forking
# a new `claude` process on top of it. Session name is fixed since each pod
# only ever runs one interactive user.
# -u: force UTF-8 for this client rather than inferring it from the locale.
# LANG=C.UTF-8 is baked into the image, but the flag is what makes the
# behaviour independent of whether that env var actually survives ttyd's fork
# or a deployment that overrides the container env — and getting it wrong is
# silent, costing only mangled non-ASCII output (see the LANG comment in the
# Dockerfile).
exec tmux -u new-session -A -s claude -- claude
