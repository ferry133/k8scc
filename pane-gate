# pane-gate -- the one reading of "is the Claude Code pane at its idle, empty
# prompt" (openspec im-chamber-client tasks 5.1). Sourced, not run, by
# chamber-watch, to decide when a line may be typed into the session.
#
# This text was moved out of inbox-watch unchanged (k8scc#59, #60), and stayed
# when inbox-watch was retired (k8scc#103); how each pattern was measured is in
# CLAUDE.md. Its fixtures are test/pane-fixtures.sh.
#
# Before sourcing, the caller may set:
#   session   the tmux session name (default claude)
#   tail      how many lines of the pane's tail are read (default 15)
#
#   WATCH_TMUX_TIMEOUT (env) seconds any one tmux call may take (default 10)
#
# pane_idle succeeds only on the idle, empty prompt of a pane that is in no
# tmux mode. Otherwise it prints one reason and returns 1, and the caller types
# nothing. The reasons are:
#   pane in a mode | mode unreadable | tmux did not answer
#   | capture-pane failed | empty pane | turn running | dialog | history search
#   | no empty prompt | empty prompt not at the bottom | menu below the prompt
#   | not logged in
# pane_screen is the same reading without the mode check: what the program in
# the pane shows. `turn running` is the only failing reason that also means
# "a session that can act".
#
# Why the mode check (k8scc#95). In copy-mode the keys of `send-keys -l` go to
# copy-mode's key table, not to the program. Some of those keys open a tmux
# prompt (measured on tmux 3.7b, 2026-11-21, both key tables: emacs f g t, vi
# 1 : f t), and `send-keys` then waits for that prompt to be answered. The
# chamber line contains them. The call stayed blocked after the pane left
# copy-mode and after the client detached, and a pod read exactly that:
# send-keys hung over 9 minutes with pane_in_mode=0. `capture-pane` shows the
# pane underneath, not copy-mode's view, so the screen alone cannot tell.
# Without a client attached the same keys fail at once ("no current client").

: "${session:=claude}"
: "${tail:=15}"
tmux_timeout="${WATCH_TMUX_TIMEOUT:-10}"
case "$tmux_timeout" in ''|*[!0-9]*|0) tmux_timeout=10 ;; esac

# tmux_t ARGS... : tmux with a time limit, so that one call that never returns
# cannot stop a watcher (k8scc#95). rc 124 = it did not return in time.
tmux_t() { timeout "$tmux_timeout" tmux "$@"; }

# pane_mode_ok : succeed when the pane is in no tmux mode (copy-mode, view-mode…)
pane_mode_ok() {
    local m rc
    m=$(tmux_t display-message -p -t "=$session:" '#{pane_in_mode}' 2>/dev/null); rc=$?
    [ "$rc" = 124 ] && { echo "tmux did not answer"; return 1; }
    [ "$rc" = 0 ] || { echo "mode unreadable"; return 1; }
    case "$m" in
        0) return 0 ;;
        1) echo "pane in a mode"; return 1 ;;
        *) echo "mode unreadable"; return 1 ;;
    esac
}

# Alternations, not bracket expressions, so multibyte characters match in any locale.
# The prompt line is judged on `capture-pane -e` (colours kept), because the
# idle prompt is not blank: measured on jg-jcc2 (Claude Code 2.1.261,
# 2026-11-10) it reads `ESC[39m❯<NBSP>ESC[2mTry "fix lint errors"` -- a DIM
# placeholder -- while one typed character reads `ESC[39m❯<NBSP>x`, not dim.
# So "empty" = after the prompt character, nothing but colour codes and box
# edges, OR the very first thing after it is the dim attribute (ESC[2m).
E=$'\e'
NBSP=$'\xc2\xa0'   # bytes, not $'\u00a0': the latter depends on the locale bash starts in
SGR="(${E}\\[[0-9;]*m)*"
EMPTY_PROMPT_BARE="^${SGR}( |│|┃)*${SGR}(>|❯)${SGR}( |${NBSP}|│|┃|${E}\\[[0-9;]*m)*\$"
EMPTY_PROMPT_DIM="^${SGR}( |│|┃)*${SGR}(>|❯)( |${NBSP})*${E}\\[2m"
MENU_OPTION='^( |│|┃)*(❯|>)?( )*[0-9]+\. '
# A session whose login has expired sits at an idle, empty prompt and answers
# everything typed into it with "Login expired · Please run /login". Read on
# jcom (production, Claude Code 2.1.261, 2026-11-25, fleet-ops-02, k8scc#70
# issuecomment-7166698330): the bridge said online=yes and `chamber send`
# returned 0 for an im that could not act. The pane's tail then carries a
# right-aligned status line "Not logged in · Run /login" directly above the
# prompt box; the "Login expired" answer was higher up, outside the tail, but
# is matched too for the beat in which it is still near. The dot is U+00B7,
# written as bytes. Whole phrases, so a session merely talking about /login is
# not taken for one.
MIDDOT=$'\xc2\xb7'
NOT_LOGGED_IN="Not logged in ${MIDDOT} Run /login|Login expired ${MIDDOT} Please run /login"

# pane_idle: succeed only when the pane is in no mode and its tail is the
# idle, empty prompt. On failure prints the reason (no pane text) and returns
# 1. Fail closed.
pane_idle() {
    pane_mode_ok || return 1
    pane_screen
}

# pane_screen: the screen half of pane_idle, without the mode check.
pane_screen() {
    local raw plain last first tail_lines tail_raw rc
    raw=$(tmux_t capture-pane -p -e -t "=$session:" 2>/dev/null); rc=$?
    [ "$rc" = 124 ] && { echo "tmux did not answer"; return 1; }
    if [ "$rc" != 0 ]; then
        echo "capture-pane failed"; return 1
    fi
    # one capture, two views with the same line numbers: colours kept (raw)
    # for the prompt line, stripped (plain) for every text check
    plain=$(printf '%s\n' "$raw" | sed "s/${E}\\[[0-9;]*[A-Za-z]//g")
    last=$(printf '%s\n' "$plain" | awk '/[^[:space:]]/{l=NR} END{print l+0}')
    [ "$last" -gt 0 ] || { echo "empty pane"; return 1; }
    first=$(( last > tail ? last - tail + 1 : 1 ))
    tail_lines=$(printf '%s\n' "$plain" | sed -n "${first},${last}p")
    tail_raw=$(printf '%s\n' "$raw" | sed -n "${first},${last}p")
    # before "turn running": a session that cannot log in is not one that can act
    if grep -qE "$NOT_LOGGED_IN" <<<"$tail_lines"; then echo "not logged in"; return 1; fi
    if grep -qiE 'esc to interrupt' <<<"$tail_lines"; then echo "turn running"; return 1; fi
    if grep -qiE 'Do you want to|Would you like to' <<<"$tail_lines"; then echo "dialog"; return 1; fi
    if grep -qiE 'reverse-i-search' <<<"$tail_lines"; then echo "history search"; return 1; fi
    local n
    n=$(grep -nE "$EMPTY_PROMPT_BARE|$EMPTY_PROMPT_DIM" <<<"$tail_raw" | tail -n1 | cut -d: -f1)
    [ -n "$n" ] || { echo "no empty prompt"; return 1; }
    local total; total=$(printf '%s\n' "$tail_lines" | wc -l | tr -d ' ')
    [ $((total - n)) -lt 6 ] || { echo "empty prompt not at the bottom"; return 1; }
    if tail -n +"$((n + 1))" <<<"$tail_lines" | grep -qE "$MENU_OPTION"; then echo "menu below the prompt"; return 1; fi
    return 0
}
